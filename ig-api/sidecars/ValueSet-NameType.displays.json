{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/pcmt/ValueSet-NameType.displays.json",
  "title": "Name Type for a Product Display Values",
  "description": "Display values for Name Type for a Product ValueSet codes. Generated from FHIR expansions. Keys are code fragments (the part after '#' in the canonical IRI). The full IRI can be reconstructed as system + '#' + code.",
  "type": "object",
  "properties": {
    "fhir:displays": {
      "type": "object",
      "description": "Multilingual display values for ValueSet codes keyed by code fragment",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "description": "Display values for a specific code fragment by language",
          "properties": {
            "en": {
              "type": "string",
              "description": "English display value"
            }
          },
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "string",
              "description": "Display value in the specified language (ISO 639-1 code)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fhir:displays"
  ],
  "additionalProperties": true,
  "fhir:displays": {
    "udi-label-name": {
      "en": "UDI Label name"
    },
    "user-friendly-name": {
      "en": "User Friendly name"
    },
    "patient-reported-name": {
      "en": "Patient Reported name"
    },
    "manufacturer-name": {
      "en": "Manufacturer name"
    },
    "model-name": {
      "en": "Model name"
    },
    "other": {
      "en": "other"
    }
  },
  "fhir:valueSet": "http://smart.who.int/pcmt/ValueSet/NameType",
  "fhir:version": "0.2.0",
  "fhir:expansionTimestamp": "2026-11-16T19:56:53+00:00"
}