    {
      "@id": "CodeSystem-pcmt-glossary",
      "@type": "fhir:CodeSystem",
      "dcterms:identifier": "CodeSystem/pcmt-glossary",
      "dcterms:title": "PCMT Glossary Terms",
      "schema:name": "PCMTGlossary",
      "dcterms:description": "CodeSystem for product attributes and terminology used in the SMART Product Catalogue Management Tool (PCMT). Core domain entities (Generic Product, Trade Item, Regulated Trade Item, Product Master Data) are anchored in the mounted dth-pc glossary (https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/).",
      "dcterms:type": "Terminology: Code Systems",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/CodeSystem/pcmt-glossary"
      },
      "schema:contentUrl": {
        "@id": "../CodeSystem-pcmt-glossary.json"
      }
    },
    {
      "@id": "StructureDefinition-DthPcRegulatedTradeItem",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/DthPcRegulatedTradeItem",
      "dcterms:title": "Regulated Trade Item (DTH product catalogue handbook, Fig. 9)",
      "dcterms:description": "A trade item as authorised in a jurisdiction, as drawn in Fig. 9 of the WHO Digital transformation handbook for health product catalogues (2025). One Trade Item has zero or more Regulated Trade Items. This IG's ProductAuthorization carries a related but different set of elements. Anchored to dth-pc glossary concept https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/regulated-trade-item.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/StructureDefinition/DthPcRegulatedTradeItem"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-DthPcRegulatedTradeItem.json"
      }
    },
    {
      "@id": "StructureDefinition-DthPcTradeItem",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/DthPcTradeItem",
      "dcterms:title": "Trade Item (DTH product catalogue handbook, Fig. 9)",
      "dcterms:description": "A packaged, identified unit of a Generic Product as traded, as drawn in Fig. 9 of the WHO Digital transformation handbook for health product catalogues (2025). One Generic Product has zero or more Trade Items. Anchored to dth-pc glossary concept https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/trade-item.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/StructureDefinition/DthPcTradeItem"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-DthPcTradeItem.json"
      }
    },
    {
      "@id": "StructureDefinition-GenericProduct",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/GenericProduct",
      "dcterms:title": "Generic Product",
      "dcterms:description": "In this handbook, the terms ‘generic product,’ ‘product,’ or ‘product information’ pertain to the general identifying details of a health product, excluding any manufacturer-specific information (WHO DTH Product Catalogue Handbook, p. 8; Ch 2, p. 28; Fig. 9, p. 29). Anchored to dth-pc glossary concept https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/generic-product.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/StructureDefinition/GenericProduct"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-GenericProduct.json"
      }
    },
    {
      "@id": "StructureDefinition-Product",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/Product",
      "dcterms:title": "Product",
      "dcterms:description": "A Product represents a physical item or set of items which can be held in inventory, ordered, exchanged, dispensed or other utilized within the health system, clinical and supply chain workflows. Anchored to dth-pc Product Master Data (https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/product-master-data) and Generic Product (https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/generic-product).",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/StructureDefinition/Product"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-Product.json"
      }
    },
    {
      "@id": "StructureDefinition-ProductAuthorization",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/ProductAuthorization",
      "dcterms:title": "Product Authorization",
      "dcterms:description": "A record of authorization or compliance for one or more Products with a set of regulatory, policy, (pre-)qualification, or legal requirements. Anchored to dth-pc Regulated Trade Item (https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/regulated-trade-item).",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/StructureDefinition/ProductAuthorization"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-ProductAuthorization.json"
      }
    },
    {
      "@id": "StructureDefinition-RegulatedTradeItem",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/RegulatedTradeItem",
      "dcterms:title": "Regulated Trade Item",
      "dcterms:description": "A Regulated Trade Item represents an authorization of a Trade item within a given jurisdiction under a Product Authorization (WHO DTH Product Catalogue Handbook, Ch 2, p. 28; Fig. 9, p. 29). Anchored to dth-pc glossary concept https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/regulated-trade-item.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/StructureDefinition/RegulatedTradeItem"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-RegulatedTradeItem.json"
      }
    },
    {
      "@id": "StructureDefinition-TradeItem",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/TradeItem",
      "dcterms:title": "Trade Item",
      "dcterms:description": "Trade items are manufacturer-specific branded health products that are identifiable and unique to a particular brand or manufacturer (WHO DTH Product Catalogue Handbook, Ch 2, p. 28; Fig. 9, p. 29). Models the WHO Product Catalogue narrow sense of Trade Item (broadMatch GS1 Trade Item per litlfred/smart-ra#142). Anchored to dth-pc glossary concept https://litlfred.github.io/dth-pc/v0/ns#glossary/dth-pc/trade-item.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/StructureDefinition/TradeItem"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-TradeItem.json"
      }
    },
    {
      "@id": "StructureDefinition-MedicationCatalogItem",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/MedicationCatalogItem",
      "dcterms:title": "Medication Catalog Item",
      "dcterms:description": "This profile represents a catalog item that is a medication",
      "dcterms:type": "Structures: Resource Profiles",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/StructureDefinition/MedicationCatalogItem"
      },
      "schema:contentUrl": {
        "@id": "../StructureDefinition-MedicationCatalogItem.json"
      }
    },
    {
      "@id": "StructureDefinition-ProductID",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/ProductID",
      "dcterms:title": "ProductID",
      "dcterms:description": "The business identifier of a  product in a product catalogue.\n\nIn FHIR R6, this could also be a reference to an InventoryItem",
      "dcterms:type": "Structures: Extension Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/pcmt/StructureDefinition/ProductID"
